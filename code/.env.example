# Example local environment for docker-compose (this file is a template —
# copy it to .env beside docker-compose.yml and fill in real values; .env
# is git-ignored and must never be committed or shared).

# Both service tokens share one validity rule: at least 32 alphanumeric
# characters (A-Z, a-z, 0-9). Generate one:  openssl rand -hex 32

# Shared secret enabling /read-config, /write-config, and /reload-config.
# A valid token is the switch — there is no separate enable flag. Two
# states:
#   1. unset, empty, or invalid (under 32 chars, or any non-alphanumeric
#      character)  -> the config endpoints are DISABLED (503 "Configuration
#                      API is disabled."), the service warns at startup and
#                      runs normally
#   2. valid (at least 32 alphanumeric characters)
#                  -> the endpoints are enabled; every request must carry
#                     a matching x-config-token header (401 otherwise)
SENSOR_TELEMETRY_CONFIG_TOKEN=

# /restart-service (POST /restart-service with an Authorization: Bearer
# header) — enabled by a VALID token; there is no separate enable flag.
# Same two states as the config token:
#   1. unset, empty, or invalid          -> endpoint disabled (503), the
#                                           service warns at startup and
#                                           runs normally (a set-but-
#                                           invalid value DISABLES it —
#                                           it never refuses to start)
#   2. valid (at least 32 alphanumeric
#      characters)                       -> endpoint enabled
# Do not reuse SENSOR_TELEMETRY_CONFIG_TOKEN — the two secrets are
# distinct. An accepted restart schedules the existing graceful SIGTERM
# shutdown; the compose restart: unless-stopped policy then starts the
# same container again.
RESTART_SERVICE_TOKEN=
