# Example local environment for docker-compose (this file is a template —
# copy it to .env beside docker-compose.yml and fill in real values; .env
# is git-ignored and must never be committed or shared).

# Optional shared secret protecting /read-config, /write-config, and
# /reload-config. When unset the config endpoints stay open (and the
# service warns at startup).
SENSOR_TELEMETRY_CONFIG_TOKEN=

# /restart-service (POST /restart-service with an Authorization: Bearer
# header) — enabled by the PRESENCE of a validated token; there is no
# separate enable flag. Three states:
#   1. unset or empty                  -> endpoint disabled (503), the
#                                         service runs normally
#   2. set, not whitespace-only,
#      at least 32 bytes               -> endpoint enabled
#   3. set but weak (whitespace-only,
#      or under 32 bytes)              -> the service REFUSES TO START
# A dummy value therefore CANNOT disable the endpoint: leave it empty (or
# unset) to disable it. Generate a token:  openssl rand -hex 32
# Do not reuse SENSOR_TELEMETRY_CONFIG_TOKEN — the two secrets are
# distinct. An accepted restart schedules the existing graceful SIGTERM
# shutdown; the compose restart: unless-stopped policy then starts the
# same container again.
RESTART_SERVICE_TOKEN=
