# Example local environment for docker-compose (this file is a template —
# copy it to .env beside docker-compose.yml and fill in real values; .env
# is git-ignored and must never be committed or shared).

# Optional shared secret protecting /read-config, /write-config, and
# /reload-config. When unset the config endpoints stay open (and the
# service warns at startup).
SENSOR_TELEMETRY_CONFIG_TOKEN=

# /restart-service opt-in — DISABLED BY DEFAULT. Leave unset/false to keep
# the endpoint off. To enable, set the flag to exactly true AND provide a
# strong, distinct token (do not reuse SENSOR_TELEMETRY_CONFIG_TOKEN).
# The service refuses to start when the flag is true and the token is
# absent. An accepted POST /restart-service (x-restart-token header)
# schedules the graceful SIGTERM shutdown; the compose
# restart: unless-stopped policy then starts the same container again.
SENSOR_TELEMETRY_RESTART_ENABLED=false
SENSOR_TELEMETRY_RESTART_TOKEN=
