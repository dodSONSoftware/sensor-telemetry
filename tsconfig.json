{
  "compilerOptions": {
    "target": "ES2016",
    "module": "NodeNext",
    "lib": [
      "ES2016"
    ],
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist/", "node_modules/", "eslint.config.mjs"]
}
